{
  "name": "use-show-window-size",
  "version": "1.1.0",
  "description": "React hook that overlays the current viewport size for development.",
  "keywords": [
    "react",
    "hook",
    "window-size",
    "viewport",
    "responsive",
    "dev-tools"
  ],
  "license": "MIT",
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/use-show-window-size.git"
  },
  "homepage": "https://use-show-window-size.kkweb.io",
  "funding": "https://github.com/sponsors/piro0919",
  "bugs": {
    "url": "https://github.com/piro0919/use-show-window-size/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:lib": "tsup",
    "build:lib:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build:lib",
    "check:package": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vercel/analytics": "2.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.15",
    "next": "^16.3.7",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "pnpm@11.27.1"
}
